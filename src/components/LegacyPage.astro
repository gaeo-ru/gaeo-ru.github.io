---
import {tokenizeLegacyPage} from '../lib/legacy.mjs';
import SharedHeader from './SharedHeader.astro';
import SharedFooter from './SharedFooter.astro';
import LeadCTA from './LeadCTA.astro';
import IndustryCommercialLanding from './IndustryCommercialLanding.astro';
import ApprovedDesignSlot from './design/ApprovedDesignSlot.astro';
const {sourcePath}=Astro.props;
const tokens=tokenizeLegacyPage(sourcePath);
---
{tokens.map(t=>t.kind==='header'
  ? <SharedHeader markup={t.content}/>
  : t.kind==='footer'
  ? <SharedFooter markup={t.content}/>
  : t.kind==='industry-commercial'
  ? <IndustryCommercialLanding sourcePath={sourcePath}/>
  : t.kind==='cta'
  ? <LeadCTA markup={t.content}/>
  : t.kind==='design'
  ? <ApprovedDesignSlot sourcePath={sourcePath} block={t.block}/>
  : <Fragment set:html={t.content}/>)}
