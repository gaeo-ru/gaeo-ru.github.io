{
  "name": "gaeo-astro-migration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/generate-evidence-pages.mjs && node scripts/generate-tariff-pages.mjs && node scripts/sync-service-feed.mjs && node scripts/generate-2gis-feed.mjs && node scripts/generate-ranking-pages.mjs && astro build",
    "check:parity": "node scripts/astro-parity.mjs",
    "check:visual": "node scripts/astro-visual-parity.mjs",
    "check:industry": "node scripts/astro-industry-browser-qa.mjs",
    "check:research": "node scripts/qa_research_article_layout.mjs",
    "check:anchors": "node scripts/qa_internal_anchor_links.mjs",
    "check:design": "node scripts/qa_approved_design_system.mjs",
    "check:tariffs": "node scripts/qa_tariffs.mjs",
    "check:specializations": "node scripts/qa_industry_specializations.mjs",
    "check:sector3a": "node scripts/qa_sector_clusters_3a.mjs && node scripts/qa_sector_methods_3b.mjs",
    "check:evidence": "node scripts/qa_evidence_pages.mjs",
    "check:rankings": "node scripts/qa_rankings.mjs",
    "check:sector3b": "node scripts/qa_sector_methods_3b.mjs",
    "check:sector3c": "node scripts/qa_sector_guides_3c.mjs",
    "check:sector3d": "node scripts/qa_sector_case_proof_3d.mjs",
    "check:sector3e": "node scripts/qa_sector_buyer_intents_3e.mjs"
  },
  "devDependencies": {
    "astro": "^6.4.6",
    "playwright": "^1.56.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  },
  "overrides": {
    "rollup": "4.68.0"
  }
}
